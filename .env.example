# Copy to .env and fill. .env is gitignored and must never be committed.

# --- Razorpay (TEST MODE ONLY for this project) ---
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in the dashboard; used for HMAC-SHA256 verification
RAZORPAY_WEBHOOK_SECRET=

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini

# --- Vendable ---
# Ed25519 private key (PEM) used to sign AP2-shaped mandates. Generated by:
#   vendable mandate keygen
VENDABLE_MANDATE_PRIVATE_KEY_PEM=
VENDABLE_MANDATE_ISSUER=https://vendable.example/mandates
# Public base URL of the deployed storefront (used in JSON-LD + /.well-known)
VENDABLE_PUBLIC_BASE_URL=http://localhost:8080
VENDABLE_ENV=local
